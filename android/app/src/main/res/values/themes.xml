<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows the system light/dark setting; Compose draws everything else
         (see ui/theme/Theme.kt). -->
    <style name="Theme.Idroid" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/idroid_window_background</item>
    </style>

    <!-- Fully invisible window: ClipboardReadActivity's momentary focus grab,
         and ShareReceiverActivity, whose only UI is a Compose dialog over
         the app the user shared from. -->
    <style name="Theme.Idroid.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
